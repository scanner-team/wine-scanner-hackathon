# Скопировать в .env и заполнить реальными значениями. Сам .env в git не
# попадает (см. .gitignore). Все переменные опциональны — без .env сервис
# стартует с безопасными значениями по умолчанию ниже.

# API-ключ для /v1/predict (контрактный эндпоинт работает без ключа).
# Обязательно задать своё значение; по умолчанию в коде нерабочее.
WINESCANNER_API_KEY=

# Контрактный эндпоинт для внешней автоматической проверки
# (/v1/eval/predict, /v1/topk). При true эндпоинт доступен; одиночное
# распознавание (/v1/predict) продолжает работать, блокируется только
# пакетная обработка (/v1/batch/run). См. docs/DEPLOYMENT.md.
WINESCANNER_ENABLE_CONTRACT_ENDPOINT=true

# Корень с данными (каталог фото, wines.csv, посчитанные векторы) — по
# умолчанию родительская папка этого файла, менять только если данные
# лежат отдельно от кода.
# WINESCANNER_BASE_DIR=/path/to/data

# Адрес локального vLLM OpenAI-совместимого сервера (чтение этикетки).
# WINESCANNER_VLLM_URL=http://localhost:8000/v1/chat/completions

# Порог уверенности для поля found в ответе и размер топ-N.
# WINESCANNER_CONFIDENCE_THRESHOLD=0.76
# WINESCANNER_TOP_K=5

# Экспериментальный BOTTLE_CROP (YOLO), по умолчанию выключен.
# Веса yolo11l.pt не входят в репозиторий.
# WINESCANNER_ENABLE_BOTTLE_CROP=false
